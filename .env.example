# Configuración para el servidor backend
PORT=5000  # Puerto para tu servidor Express

# MongoDB local
MONGO_LOCAL_URI=mongodb://localhost:27017/nombre_de_tu_base_local

# MongoDB Atlas (reemplaza con tus credenciales reales)
MONGO_ATLAS_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<nombre_de_tu_base>?retryWrites=true&w=majority

# Activa la configuración deseada descomentando la línea correcta
MONGO_URI=mongodb://localhost:27017/nombre_de_tu_base_local
# MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<nombre_de_tu_base>?retryWrites=true&w=majority
